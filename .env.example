# Copy to .env and fill with your real values. .env is gitignored — never commit it.
# Chat only (low volume). Embeddings are local Ollama by default — no quota, no key.
GEMINI_API_KEY=your-google-gemini-api-key
GITHUB_TOKEN=your-github-pat

# Embeddings: ollama = permanently free local (recommended) | gemini = quota-limited cloud
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Postgres / pgvector (see docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=repolens
DB_USER=repolens
DB_PASSWORD=repolens
